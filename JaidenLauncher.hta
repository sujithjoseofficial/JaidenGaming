                1 YEAR
            </span>

            <span class="planPrice">
                AED 1,000
            </span>

        </button>


        <button class="plan"
                onclick="SelectLifetime">

            <span class="planName">
                LIFETIME
            </span>

            <span class="planPrice">
                AED 3,000
            </span>

        </button>


        <div class="codeArea">

            <div class="codeTitle">
                ENTER 10-DIGIT ACTIVATION CODE
            </div>


            <input
                id="activationCode"
                class="codeInput"
                type="text"
                maxlength="10"
                autocomplete="off"
                spellcheck="false">


            <div id="selectedPlan"
                 class="selectedPlan">

