<script language="VBScript">

Option Explicit

Dim shell
Dim fso

Dim gameFolder
Dim gtaExe
Dim rageExe
Dim launcherPath

'========================================================
' GITHUB UPDATE FILES
'========================================================

Dim githubHTA
Dim githubVersion
Dim githubWhatsNew

Dim updateFolder
Dim updateFile
Dim updateVersionFile
Dim whatsNewFile
Dim renamedUpdateFile

Dim launcherVersion
Dim updateVersion

Dim githubVersionText
Dim githubWhatsNewText


'========================================================
' LOGIN
'========================================================

Dim adminID
Dim adminPassword

Dim loginIDPrefix
Dim passwordPrefix

Dim failedAttempts
Dim settingsLocked

Dim restartFlagFile


'========================================================
' SUBSCRIPTION VARIABLES
'========================================================

Dim subscriptionFolder
Dim subscriptionFile

Dim subscriptionPlan
Dim subscriptionStart
Dim subscriptionEnd

Dim selectedPlan
Dim selectedPrice
Dim selectedSeconds

Dim subscriptionActive

Const ACTIVATION_CODE = "0000000000"

Const LIFETIME_SECONDS = 9999999999


Set shell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")


'========================================================
' VERSION
'========================================================

launcherVersion = "6.0"
updateVersion = ""

githubVersionText = ""
githubWhatsNewText = ""


'========================================================
' PATHS
'========================================================

gameFolder = "D:\Games\Grand Theft Auto V"

gtaExe = gameFolder & "\PlayGTAV.exe"

rageExe = gameFolder & "\RAGEPluginHook.exe"

launcherPath = _
"C:\Users\sujo2\OneDrive\Documents\Jaiden Launcher\JaidenLauncher.hta"


'========================================================
' UPDATE STORAGE
'
' GitHub is now the SOURCE.
'
' The downloaded files are temporarily stored here.
'========================================================

updateFolder = _
shell.ExpandEnvironmentStrings("%TEMP%") & _
"\JaidenGamingUpdates"

updateFile = _
updateFolder & "\JaidenLauncher.hta"

updateVersionFile = _
updateFolder & "\version.txt"

whatsNewFile = _
updateFolder & "\whatsnew.txt"

renamedUpdateFile = _
updateFolder & "\JaidenLauncher.hta.installed"


'========================================================
' GITHUB RAW URLS
'
' Built in pieces so the URL remains easy to edit.
'========================================================

githubHTA = _
"https://" & _
"raw.githubusercontent.com/" & _
"sujithjoseofficial/" & _
"JaidenGaming/" & _
"refs/heads/main/" & _
"JaidenLauncher.hta"

githubVersion = _
"https://" & _
"raw.githubusercontent.com/" & _
"sujithjoseofficial/" & _
"JaidenGaming/" & _
"refs/heads/main/" & _
"version.txt"

githubWhatsNew = _
"https://" & _
"raw.githubusercontent.com/" & _
"sujithjoseofficial/" & _
"JaidenGaming/" & _
"refs/heads/main/" & _
"whatsnew.txt"


'========================================================
' SUBSCRIPTION STORAGE
'========================================================

subscriptionFolder = _
shell.ExpandEnvironmentStrings("%APPDATA%") & _
"\JaidenGaming"

subscriptionFile = _
subscriptionFolder & "\subscription.dat"


subscriptionPlan = ""
subscriptionStart = 0
subscriptionEnd = 0
subscriptionActive = False

selectedPlan = ""
selectedPrice = 0
selectedSeconds = 0


'========================================================
' LOGIN
'========================================================

loginIDPrefix = "1111111111111111111111"

passwordPrefix = "11111111111111111111"

adminID = loginIDPrefix & "SJGAMING"

adminPassword = passwordPrefix & "4848"

failedAttempts = 0
settingsLocked = False


'========================================================
' WINDOW LOAD
'========================================================

Sub Window_OnLoad

    LoadSubscription

    CheckSubscription

    CheckStatus

    SetVersionDisplay

    window.setTimeout "AutoOpenUpdates", 1200

End Sub


'========================================================
' AUTOMATIC GITHUB UPDATE CHECK
'========================================================

Sub AutoOpenUpdates

    CheckForUpdatesSilent

End Sub


Sub CheckForUpdatesSilent

    Dim remoteVersionText
    Dim localNumber
    Dim remoteNumber

    remoteVersionText = ""

    '----------------------------------------------------
    ' GET version.txt DIRECTLY FROM GITHUB
    '----------------------------------------------------

    remoteVersionText = DownloadText(githubVersion)

    If remoteVersionText = "" Then

        Exit Sub

    End If


    remoteVersionText = CleanVersionText(remoteVersionText)

    If remoteVersionText = "" Then

        Exit Sub

    End If


    githubVersionText = remoteVersionText

    updateVersion = remoteVersionText


    localNumber = GetVersionNumber(launcherVersion)

    remoteNumber = GetVersionNumber(remoteVersionText)


    If remoteNumber > localNumber Then

        CheckForUpdates

    End If

End Sub


'========================================================
' UPDATE CHECK WINDOW
'========================================================

Sub CheckForUpdates

    document.getElementById("updateOverlay").style.display = "block"

    document.getElementById("updateChecking").style.display = "block"

    document.getElementById("updateAvailable").style.display = "none"

    document.getElementById("updateInstalling").style.display = "none"

    document.getElementById("updateCompleted").style.display = "none"

    document.getElementById("updateText").innerHTML = _
        "CHECKING SJ SERVER FOR UPDATES..."

    window.setTimeout "CheckGitHubUpdate", 300

End Sub


'========================================================
' CHECK GITHUB VERSION
'========================================================

Sub CheckGitHubUpdate

    Dim remoteVersionText
    Dim localNumber
    Dim remoteNumber

    remoteVersionText = ""

    document.getElementById("updateChecking").style.display = "block"

    document.getElementById("updateText").innerHTML = _
        "CONNECTING TO GITHUB..."


    '----------------------------------------------------
    ' DOWNLOAD VERSION.TXT
    '----------------------------------------------------

    remoteVersionText = DownloadText(githubVersion)


    If remoteVersionText = "" Then

        document.getElementById("updateChecking").style.display = "none"

        document.getElementById("updateText").innerHTML = _
            "COULD NOT CONNECT TO GITHUB." & _
            "<br><br>" & _
            "Please check your internet connection."

        window.setTimeout "CloseUpdateAfterCheck", 4000

        Exit Sub

    End If


    remoteVersionText = CleanVersionText(remoteVersionText)


    If remoteVersionText = "" Then

        document.getElementById("updateChecking").style.display = "none"

        document.getElementById("updateText").innerHTML = _
            "GITHUB VERSION FILE IS EMPTY OR INVALID."

        window.setTimeout "CloseUpdateAfterCheck", 4000

        Exit Sub

    End If


    githubVersionText = remoteVersionText

    updateVersion = remoteVersionText


    localNumber = GetVersionNumber(launcherVersion)

    remoteNumber = GetVersionNumber(remoteVersionText)


    document.getElementById("updateChecking").style.display = "none"


    '====================================================
    ' NEW VERSION
    '====================================================

    If remoteNumber > localNumber Then

        document.getElementById("updateAvailable").style.display = "block"

        document.getElementById("updateText").innerHTML = _
            "NEW VERSION AVAILABLE" & _
            "<br><br>" & _
            "Installed: v" & launcherVersion & _
            "<br>" & _
            "Available: v" & remoteVersionText

        '------------------------------------------------
        ' Download What's New from GitHub
        '------------------------------------------------

        LoadGitHubWhatsNew

        Exit Sub

    End If


    '====================================================
    ' SAME VERSION
    '====================================================

    If remoteNumber = localNumber Then

        document.getElementById("updateText").innerHTML = _
            "YOUR JAIDEN GAMING LAUNCHER IS UP TO DATE." & _
            "<br><br>" & _
            "Current Version: v" & launcherVersion

        window.setTimeout "CloseUpdateAfterCheck", 3000

        Exit Sub

    End If


    '====================================================
    ' REMOTE VERSION IS OLDER
    '====================================================

    document.getElementById("updateText").innerHTML = _
        "NO NEWER UPDATE IS AVAILABLE." & _
        "<br><br>" & _
        "Installed: v" & launcherVersion & _
        "<br>" & _
        "GitHub: v" & remoteVersionText

    window.setTimeout "CloseUpdateAfterCheck", 3000

End Sub


'========================================================
' DOWNLOAD WHAT'S NEW FROM GITHUB
'========================================================

Sub LoadGitHubWhatsNew

    Dim whatsNewText
    Dim line
    Dim lines
    Dim i
    Dim whatsNewHTML

    whatsNewText = ""

    document.getElementById("updateText").innerHTML = _
        "SJ SERVER ONLINE 3.0"


    whatsNewText = DownloadText(githubWhatsNew)


    If whatsNewText = "" Then

        document.getElementById("whatsNewContent").innerHTML = _
            "<div>" & _
            "<span class='whatsNewBullet'>+</span>" & _
            "New launcher improvements and fixes" & _
            "</div>"

        Exit Sub

    End If


    githubWhatsNewText = whatsNewText

    whatsNewHTML = ""

    lines = Split(Replace(whatsNewText, vbCrLf, vbLf), vbLf)


    For i = 0 To UBound(lines)

        line = Trim(lines(i))


        If line <> "" Then

            whatsNewHTML = whatsNewHTML & _
                "<div>" & _
                "<span class='whatsNewBullet'>+</span>" & _
                HtmlEncode(line) & _
                "</div>"

        End If

    Next


    If whatsNewHTML = "" Then

        whatsNewHTML = _
            "<div>" & _
            "<span class='whatsNewBullet'>+</span>" & _
            "New launcher improvements and fixes" & _
            "</div>"

    End If


    document.getElementById("whatsNewContent").innerHTML = _
        whatsNewHTML

End Sub


'========================================================
' GENERIC GITHUB TEXT DOWNLOAD
'
' Uses MSXML2.XMLHTTP.
'
' Timestamp prevents old cached data.
'========================================================

Function DownloadText(url)

    Dim http
    Dim finalURL
    Dim resultText

    DownloadText = ""

    On Error Resume Next

    Set http = CreateObject("MSXML2.XMLHTTP")

    If Err.Number <> 0 Then

        Err.Clear

        Set http = CreateObject("Microsoft.XMLHTTP")

    End If


    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo 0

        Exit Function

    End If


    finalURL = url & "?_=" & CStr(Timer * 1000)


    http.Open "GET", finalURL, False

    http.setRequestHeader "Cache-Control", "no-cache"

    http.setRequestHeader "Pragma", "no-cache"

    http.setRequestHeader "User-Agent", _
        "JaidenGamingLauncher"


    http.Send


    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo 0

        Exit Function

    End If


    If http.Status >= 200 And http.Status < 300 Then

        resultText = http.responseText

        DownloadText = resultText

    Else

        DownloadText = ""

    End If


    Set http = Nothing

    On Error GoTo 0

End Function


'========================================================
' DOWNLOAD BINARY / HTA FILE FROM GITHUB
'
' Uses ADODB.Stream.
'========================================================

Function DownloadFile(url, destination)

    Dim http
    Dim stream
    Dim finalURL

    DownloadFile = False

    On Error Resume Next

    Set http = CreateObject("MSXML2.XMLHTTP")

    If Err.Number <> 0 Then

        Err.Clear

        Set http = CreateObject("Microsoft.XMLHTTP")

    End If


    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo 0

        Exit Function

    End If


    finalURL = url & "?_=" & CStr(Timer * 1000)


    http.Open "GET", finalURL, False

    http.setRequestHeader "Cache-Control", "no-cache"

    http.setRequestHeader "Pragma", "no-cache"

    http.setRequestHeader "User-Agent", _
        "JaidenGamingLauncher"


    http.Send


    If Err.Number <> 0 Then

        Err.Clear

        Set http = Nothing

        On Error GoTo 0

        Exit Function

    End If


    If http.Status < 200 Or http.Status >= 300 Then

        Set http = Nothing

        On Error GoTo 0

        Exit Function

    End If


    Set stream = CreateObject("ADODB.Stream")


    If Err.Number <> 0 Then

        Err.Clear

        Set http = Nothing

        On Error GoTo 0

        Exit Function

    End If


    stream.Type = 1

    stream.Open

    stream.Write http.responseBody


    If fso.FileExists(destination) Then

        fso.DeleteFile destination, True

    End If


    stream.SaveToFile destination, 2

    stream.Close


    Set stream = Nothing

    Set http = Nothing


    If fso.FileExists(destination) Then

        If fso.GetFile(destination).Size > 0 Then

            DownloadFile = True

        End If

    End If


    On Error GoTo 0

End Function


'========================================================
' CLEAN VERSION TEXT
'========================================================

Function CleanVersionText(value)

    Dim result

    result = Trim(value)

    result = Replace(result, vbCr, "")

    result = Replace(result, vbLf, "")

    result = Replace(result, Chr(34), "")

    result = Trim(result)


    If LCase(Left(result, 1)) = "v" Then

        result = Mid(result, 2)

    End If


    CleanVersionText = result

End Function


'========================================================
' HTML ENCODE
'========================================================

Function HtmlEncode(value)

    value = Replace(value, "&", "&amp;")

    value = Replace(value, "<", "&lt;")

    value = Replace(value, ">", "&gt;")

    value = Replace(value, """", "&quot;")

    HtmlEncode = value

End Function


'========================================================
' VERSION NUMBER
'========================================================

Function GetVersionNumber(versionText)

    Dim parts
    Dim major
    Dim minor
    Dim patch
    Dim cleanVersion

    cleanVersion = Trim(versionText)


    If LCase(Left(cleanVersion, 1)) = "v" Then

        cleanVersion = Mid(cleanVersion, 2)

    End If


    parts = Split(cleanVersion, ".")

    major = 0
    minor = 0
    patch = 0


    If UBound(parts) >= 0 Then

        If IsNumeric(parts(0)) Then

            major = CInt(parts(0))

        End If

    End If


    If UBound(parts) >= 1 Then

        If IsNumeric(parts(1)) Then

            minor = CInt(parts(1))

        End If

    End If


    If UBound(parts) >= 2 Then

        If IsNumeric(parts(2)) Then

            patch = CInt(parts(2))

        End If

    End If


    GetVersionNumber = _
        (major * 10000) + _
        (minor * 100) + _
        patch

End Function


'========================================================
' CLOSE UPDATE WINDOW
'========================================================

Sub CloseUpdateAfterCheck

    document.getElementById("updateOverlay").style.display = "none"

End Sub


'========================================================
' UPDATE NOW
'========================================================

Sub UpdateNow

    document.getElementById("updateAvailable").style.display = "none"

    document.getElementById("updateInstalling").style.display = "block"

    document.getElementById("updateText").innerHTML = _
        "DOWNLOADING UPDATE FROM SJ SERVER..."

    window.setTimeout "PerformUpdate", 300

End Sub


'========================================================
' PERFORM GITHUB UPDATE
'========================================================

Sub PerformUpdate

    Dim errorText
    Dim downloaded
    Dim folderCreated

    downloaded = False

    errorText = ""


    On Error Resume Next

    '----------------------------------------------------
    ' Create temporary update folder
    '----------------------------------------------------

    If Not fso.FolderExists(updateFolder) Then

        fso.CreateFolder updateFolder

    End If


    If Err.Number <> 0 Then

        errorText = Err.Description

        Err.Clear

    End If


    On Error GoTo 0


    If errorText <> "" Then

        UpdateInstallError errorText

        Exit Sub

    End If


    '====================================================
    ' DOWNLOAD LATEST HTA FROM GITHUB
    '====================================================

    document.getElementById("updateText").innerHTML = _
        "DOWNLOADING JAIDENLAUNCHER.HTA..."


    downloaded = _
        DownloadFile( _
            githubHTA, _
            updateFile)


    If downloaded = False Then

        UpdateInstallError _
            "Could not download JaidenLauncher.hta from GitHub."

        Exit Sub

    End If


    '====================================================
    ' VERIFY DOWNLOADED FILE
    '====================================================

    If Not fso.FileExists(updateFile) Then

        UpdateInstallError _
            "Downloaded update file was not found."

        Exit Sub

    End If


    If fso.GetFile(updateFile).Size < 100 Then

        UpdateInstallError _
            "Downloaded launcher file appears to be invalid."

        Exit Sub

    End If


    '====================================================
    ' DOWNLOAD VERSION.TXT
    '====================================================

    document.getElementById("updateText").innerHTML = _
        "DOWNLOADING VERSION INFORMATION..."


    DownloadFile _
        githubVersion, _
        updateVersionFile


    '====================================================
    ' DOWNLOAD WHAT'S NEW
    '====================================================

    document.getElementById("updateText").innerHTML = _
        "DOWNLOADING WHAT'S NEW..."


    DownloadFile _
        githubWhatsNew, _
        whatsNewFile


    '====================================================
    ' INSTALL
    '====================================================

    document.getElementById("updateText").innerHTML = _
        "INSTALLING UPDATE..."


    window.setTimeout "InstallDownloadedUpdate", 500

End Sub


'========================================================
' INSTALL DOWNLOADED UPDATE
'========================================================

Sub InstallDownloadedUpdate

    Dim tempInstall
    Dim errorText
    Dim success

    success = False

    errorText = ""


    tempInstall = _
        launcherPath & ".new"


    On Error Resume Next

    Err.Clear


    '----------------------------------------------------
    ' Copy GitHub update to .new first.
    ' This prevents a partial launcher replacement.
    '----------------------------------------------------

    If fso.FileExists(tempInstall) Then

        fso.DeleteFile tempInstall, True

    End If


    fso.CopyFile _
        updateFile, _
        tempInstall, _
        True


    If Err.Number <> 0 Then

        errorText = Err.Description

        Err.Clear

    End If


    If errorText = "" Then

        If Not fso.FileExists(tempInstall) Then

            errorText = _
                "The temporary update file could not be created."

        End If

    End If


    '----------------------------------------------------
    ' Create restart helper
    '----------------------------------------------------

    If errorText = "" Then

        document.getElementById("updateText").innerHTML = _
            "UPDATE DOWNLOADED SUCCESSFULLY"

        document.getElementById("updateInstalling").style.display = "none"

        document.getElementById("updateCompleted").style.display = "block"

        document.getElementById("updateText").innerHTML = _
            "UPDATE COMPLETED"

        window.setTimeout "RestartLauncher", 2000

        On Error GoTo 0

        Exit Sub

    End If


    On Error GoTo 0


    UpdateInstallError errorText

End Sub


'========================================================
' UPDATE ERROR
'========================================================

Sub UpdateInstallError(message)

    document.getElementById("updateInstalling").style.display = "none"

    document.getElementById("updateCompleted").style.display = "none"

    document.getElementById("updateText").innerHTML = _
        "UPDATE FAILED" & _
        "<br><br>" & _
        HtmlEncode(message)

    window.setTimeout "CloseUpdateAfterCheck", 5000

End Sub


'========================================================
' UPDATE LATER
'========================================================

Sub UpdateLater

    document.getElementById("updateOverlay").style.display = "none"

End Sub


'========================================================
' RESTART LAUNCHER
'
' A temporary VBS waits for this HTA to close,
' replaces the old launcher with the downloaded one,
' then starts the new launcher.
'========================================================

Sub RestartLauncher

    Dim tempVbs
    Dim ts
    Dim vbsCode
    Dim newLauncher
    Dim newFile

    newLauncher = launcherPath

    newFile = launcherPath & ".new"


    tempVbs = _
        shell.ExpandEnvironmentStrings("%TEMP%") & _
        "\JaidenGamingRestart.vbs"


    On Error Resume Next


    If fso.FileExists(restartFlagFile) Then

        fso.DeleteFile restartFlagFile, True

    End If


    '----------------------------------------------------
    ' Flag is not required for update detection anymore,
    ' but retained as a restart marker.
    '----------------------------------------------------

    fso.CreateTextFile restartFlagFile, True


    On Error GoTo 0


    '====================================================
    ' CREATE VBS RESTARTER
    '====================================================

    vbsCode = ""

    vbsCode = vbsCode & _
        "Set fso = CreateObject(""Scripting.FileSystemObject"")" & vbCrLf

    vbsCode = vbsCode & _
        "Set sh = CreateObject(""WScript.Shell"")" & vbCrLf

    vbsCode = vbsCode & _
        "WScript.Sleep 2500" & vbCrLf

    vbsCode = vbsCode & _
        "On Error Resume Next" & vbCrLf

    vbsCode = vbsCode & _
        "If fso.FileExists(""" & newLauncher & """) Then" & vbCrLf

    vbsCode = vbsCode & _
        "fso.DeleteFile """ & newLauncher & """, True" & vbCrLf

    vbsCode = vbsCode & _
        "End If" & vbCrLf

    vbsCode = vbsCode & _
        "WScript.Sleep 500" & vbCrLf

    vbsCode = vbsCode & _
        "fso.MoveFile """ & newFile & """, """ & newLauncher & """" & vbCrLf

    vbsCode = vbsCode & _
        "WScript.Sleep 1000" & vbCrLf

    vbsCode = vbsCode & _
        "sh.Run ""mshta.exe "" & Chr(34) & """ & _
        newLauncher & """ & Chr(34), 1, False" & vbCrLf

    vbsCode = vbsCode & _
        "WScript.Sleep 5000" & vbCrLf

    vbsCode = vbsCode & _
        "If fso.FileExists(WScript.ScriptFullName) Then" & vbCrLf

    vbsCode = vbsCode & _
        "fso.DeleteFile WScript.ScriptFullName, True" & vbCrLf

    vbsCode = vbsCode & _
        "End If" & vbCrLf


    Set ts = fso.CreateTextFile(tempVbs, True)

    ts.Write vbsCode

    ts.Close


    shell.Run _
        "wscript.exe """ & tempVbs & """", _
        0, _
        False


    window.close

End Sub


'========================================================
' STATUS
'========================================================

Sub CheckStatus

    If fso.FileExists(gtaExe) Then

        document.getElementById("gtaStatus").innerHTML = _
            "<span class='ready'>READY</span>"

    Else

        document.getElementById("gtaStatus").innerHTML = _
            "<span class='error'>NOT FOUND</span>"

    End If


    If fso.FileExists(rageExe) Then

        document.getElementById("sjStatus").innerHTML = _
            "<span class='ready'>READY</span>"

    Else

        document.getElementById("sjStatus").innerHTML = _
            "<span class='error'>NOT FOUND</span>"

    End If

End Sub


'========================================================
' PLAY GAME
'========================================================

Sub PlayGame

    CheckSubscription

    If subscriptionActive = False Then

        OpenSubscription

        Exit Sub

    End If


    If Not fso.FileExists(gtaExe) Then

        MsgBox _
            "GTA V was not found." & vbCrLf & vbCrLf & _
            gtaExe, _
            vbCritical, _
            "JAIDEN GAMING"

        Exit Sub

    End If


    If Not fso.FileExists(rageExe) Then

        MsgBox _
            "SJ Gaming component was not found." & _
            vbCrLf & vbCrLf & rageExe, _
            vbCritical, _
            "JAIDEN GAMING"

        Exit Sub

    End If


    document.getElementById("playButton").disabled = True

    document.getElementById("loadingScreen").style.display = "block"

    document.getElementById("loadingStatus").innerHTML = _
        "STARTING GRAND THEFT AUTO V"


    shell.CurrentDirectory = gameFolder

    shell.Run """" & gtaExe & """", 1, False

    window.setTimeout "StartSJGaming", 10000

End Sub


Sub StartSJGaming

    document.getElementById("loadingStatus").innerHTML = _
        "STARTING SJ GAMING"

    shell.CurrentDirectory = gameFolder

    shell.Run """" & rageExe & """", 1, False

    window.setTimeout "LaunchComplete", 1500

End Sub


Sub LaunchComplete

    document.getElementById("loadingStatus").innerHTML = _
        "LAUNCH COMPLETE"

    window.setTimeout "CloseLauncher", 1000

End Sub


Sub CloseLauncher

    window.close

End Sub


'========================================================
' GAME FOLDER
'========================================================

Sub OpenGameFolder

    If fso.FolderExists(gameFolder) Then

        shell.Run _
            "explorer.exe """ & gameFolder & """", _
            1, _
            False

    Else

        MsgBox _
            "Game folder was not found." & _
            vbCrLf & vbCrLf & gameFolder, _
            vbCritical, _
            "JAIDEN GAMING"

    End If

End Sub


'========================================================
' SETTINGS
'========================================================

Sub OpenSettings

    If settingsLocked = True Then

        document.getElementById("lockOverlay").style.display = "block"

        Exit Sub

    End If


    document.getElementById("loginOverlay").style.display = "block"

    document.getElementById("loginID").value = loginIDPrefix

    document.getElementById("loginPassword").value = passwordPrefix

    document.getElementById("loginError").style.display = "none"

    window.setTimeout "FocusLogin", 100

End Sub


Sub FocusLogin

    document.getElementById("loginID").focus

End Sub


Sub ProtectLoginID

    Dim box
    Dim value

    Set box = document.getElementById("loginID")

    value = box.value


    If Len(value) < Len(loginIDPrefix) Then

        LockSecurity

        Exit Sub

    End If


    If Left(value, Len(loginIDPrefix)) <> loginIDPrefix Then

        LockSecurity

        Exit Sub

    End If

End Sub


Sub ProtectPassword

    Dim box
    Dim value

    Set box = document.getElementById("loginPassword")

    value = box.value


    If Len(value) < Len(passwordPrefix) Then

        LockSecurity

        Exit Sub

    End If


    If Left(value, Len(passwordPrefix)) <> passwordPrefix Then

        LockSecurity

        Exit Sub

    End If

End Sub


Sub LockSecurity

    settingsLocked = True

    document.getElementById("loginOverlay").style.display = "none"

    document.getElementById("lockOverlay").style.display = "block"

End Sub


Sub AdminLogin

    Dim enteredID
    Dim enteredPassword

    If settingsLocked = True Then Exit Sub

    ProtectLoginID

    If settingsLocked = True Then Exit Sub

    ProtectPassword

    If settingsLocked = True Then Exit Sub


    enteredID = _
        document.getElementById("loginID").value

    enteredPassword = _
        document.getElementById("loginPassword").value


    If UCase(Trim(enteredID)) = _
       UCase(adminID) _
       And enteredPassword = adminPassword Then


        failedAttempts = 0

        document.getElementById("loginOverlay").style.display = "none"


        If fso.FileExists(launcherPath) Then

            shell.Run _
                "notepad.exe """ & launcherPath & """", _
                1, _
                False

        Else

            MsgBox _
                "JaidenLauncher.hta was not found." & _
                vbCrLf & vbCrLf & _
                launcherPath, _
                vbCritical, _
                "JAIDEN GAMING"

        End If

        Exit Sub

    End If


    failedAttempts = failedAttempts + 1

    document.getElementById("loginError").style.display = "block"

    document.getElementById("loginError").innerHTML = _
        "ACCESS DENIED - INVALID LOGIN ID OR PASSWORD"

    document.getElementById("loginPassword").value = passwordPrefix


    If failedAttempts >= 3 Then

        settingsLocked = True

        document.getElementById("loginOverlay").style.display = "none"

        document.getElementById("lockOverlay").style.display = "block"

        Exit Sub

    End If


    document.getElementById("loginID").focus

End Sub


Sub CancelLogin

    document.getElementById("loginOverlay").style.display = "none"

End Sub


Sub CloseSettings

    document.getElementById("settingsOverlay").style.display = "none"

End Sub


Sub CloseLockScreen

    document.getElementById("lockOverlay").style.display = "none"

End Sub


'========================================================
' SUBSCRIPTION
'========================================================

Sub OpenSubscription

    CheckSubscription

    document.getElementById("subscriptionOverlay").style.display = "block"

    UpdateSubscriptionWindow

End Sub


Sub CloseSubscription

    document.getElementById("subscriptionOverlay").style.display = "none"

End Sub


'========================================================
' PLAN SELECTION
'========================================================

Sub SelectPlan(planName, price, seconds)

    selectedPlan = planName

    selectedPrice = price

    selectedSeconds = seconds


    document.getElementById("selectedPlan").innerHTML = _
        "SELECTED: " & selectedPlan & _
        " - AED " & selectedPrice


    document.getElementById("codeError").style.display = "none"

    document.getElementById("activationCode").focus

End Sub


Sub SelectOneMinute

    SelectPlan "1 MINUTE", 1, 60

End Sub


Sub SelectOneDay

    SelectPlan "1 HOUR", 30, 3600

End Sub


Sub SelectThreeDays

    SelectPlan "3 HOURS", 50, 10800

End Sub


Sub SelectSevenDays

    SelectPlan "7 DAYS", 70, 604800

End Sub


Sub SelectOneMonth

    SelectPlan "1 MONTH", 100, 2592000

End Sub


Sub SelectSixMonths

    SelectPlan "6 MONTHS", 500, 15552000

End Sub


Sub SelectOneYear

    SelectPlan "1 YEAR", 1000, 31536000

End Sub


'========================================================
' LIFETIME
'========================================================

Sub SelectLifetime

    selectedPlan = "LIFETIME"

    selectedPrice = 3000

    selectedSeconds = LIFETIME_SECONDS


    document.getElementById("selectedPlan").innerHTML = _
        "SELECTED: LIFETIME - AED 3,000"


    document.getElementById("codeError").style.display = "none"

    document.getElementById("activationCode").focus

End Sub


'========================================================
' ACTIVATE SUBSCRIPTION
'========================================================

Sub ActivateSubscription

    Dim enteredCode

    enteredCode = _
        Trim(document.getElementById("activationCode").value)


    If selectedPlan = "" Then

        document.getElementById("codeError").style.display = "block"

        document.getElementById("codeError").innerHTML = _
            "PLEASE SELECT A SUBSCRIPTION PLAN FIRST."

        Exit Sub

    End If


    If enteredCode <> ACTIVATION_CODE Then

        document.getElementById("codeError").style.display = "block"

        document.getElementById("codeError").innerHTML = _
            "INVALID ACTIVATION CODE. PLEASE ENTER THE CORRECT 10-DIGIT CODE."

        Exit Sub

    End If


    subscriptionPlan = selectedPlan

    subscriptionStart = UnixTime()


    If UCase(subscriptionPlan) = "LIFETIME" Then

        subscriptionEnd = 0

    Else

        subscriptionEnd = _
            subscriptionStart + selectedSeconds

    End If


    subscriptionActive = True


    SaveSubscription


    document.getElementById("codeError").style.display = "none"

    document.getElementById("activationCode").value = ""


    UpdateSubscriptionDisplay

    UpdateSubscriptionWindow


    MsgBox _
        "Subscription activated successfully!" & _
        vbCrLf & vbCrLf & _
        "Plan: " & subscriptionPlan & _
        vbCrLf & _
        "Price: AED " & selectedPrice & _
        vbCrLf & vbCrLf & _
        "Your subscription is now active.", _
        vbInformation, _
        "JAIDEN GAMING"

End Sub


'========================================================
' SAVE SUBSCRIPTION
'========================================================

Sub SaveSubscription

    Dim ts

    On Error Resume Next


    If Not fso.FolderExists(subscriptionFolder) Then

        fso.CreateFolder subscriptionFolder

    End If


    Set ts = fso.CreateTextFile(subscriptionFile, True)

    ts.WriteLine subscriptionPlan

    ts.WriteLine CStr(subscriptionStart)

    ts.WriteLine CStr(subscriptionEnd)

    ts.Close


    On Error GoTo 0

End Sub


'========================================================
' LOAD SUBSCRIPTION
'========================================================

Sub LoadSubscription

    Dim ts

    subscriptionPlan = ""

    subscriptionStart = 0

    subscriptionEnd = 0

    subscriptionActive = False


    If Not fso.FileExists(subscriptionFile) Then

        Exit Sub

    End If


    On Error Resume Next


    Set ts = fso.OpenTextFile( _
        subscriptionFile, _
        1, _
        False)


    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo 0

        Exit Sub

    End If


    If Not ts.AtEndOfStream Then

        subscriptionPlan = Trim(ts.ReadLine)

    End If


    If Not ts.AtEndOfStream Then

        subscriptionStart = CDbl(Trim(ts.ReadLine))

    End If


    If Not ts.AtEndOfStream Then

        subscriptionEnd = CDbl(Trim(ts.ReadLine))

    End If


    ts.Close


    On Error GoTo 0

End Sub


'========================================================
' CHECK SUBSCRIPTION
'========================================================

Sub CheckSubscription

    If UCase(Trim(subscriptionPlan)) = "LIFETIME" Then

        subscriptionActive = True

        UpdateSubscriptionDisplay

        Exit Sub

    End If


    If subscriptionEnd <= 0 Then

        subscriptionActive = False

        UpdateSubscriptionDisplay

        Exit Sub

    End If


    If UnixTime() >= subscriptionEnd Then

        If subscriptionActive = True Then

            subscriptionActive = False

            SaveSubscription

            ShowExpiredScreen

        Else

            subscriptionActive = False

        End If

    Else

        subscriptionActive = True

    End If


    UpdateSubscriptionDisplay

End Sub


'========================================================
' DASHBOARD SUBSCRIPTION DISPLAY
'========================================================

Sub UpdateSubscriptionDisplay

    Dim remaining


    If subscriptionActive = True Then

        document.getElementById("subscriptionStatus").innerHTML = _
            "<span class='ready'>ACTIVE</span>"


        document.getElementById("subscriptionPlanDisplay").innerHTML = _
            subscriptionPlan


        If UCase(Trim(subscriptionPlan)) = "LIFETIME" Then

            document.getElementById("subscriptionTimeDisplay").innerHTML = _
                "LIFETIME"

        Else

            remaining = subscriptionEnd - UnixTime()

            If remaining < 0 Then remaining = 0

            document.getElementById("subscriptionTimeDisplay").innerHTML = _
                FormatDuration(remaining)

        End If


    Else

        document.getElementById("subscriptionStatus").innerHTML = _
            "<span class='error'>TRIAL / EXPIRED</span>"

        document.getElementById("subscriptionPlanDisplay").innerHTML = _
            "TRIAL VERSION"

        document.getElementById("subscriptionTimeDisplay").innerHTML = _
            "SUBSCRIBE TO CONTINUE"

    End If

End Sub


'========================================================
' SUBSCRIPTION WINDOW
'========================================================

Sub UpdateSubscriptionWindow

    Dim remaining


    If subscriptionActive = True Then

        If UCase(Trim(subscriptionPlan)) = "LIFETIME" Then

            document.getElementById("trialNotice").innerHTML = _
                "LIFETIME SUBSCRIPTION ACTIVE - NO EXPIRATION"


            document.getElementById("selectedPlan").innerHTML = _
                "CURRENT PLAN: LIFETIME - AED 3,000"


        Else

            remaining = subscriptionEnd - UnixTime()

            If remaining < 0 Then remaining = 0


            document.getElementById("trialNotice").innerHTML = _
                "SUBSCRIPTION ACTIVE - " & _
                subscriptionPlan & _
                " - REMAINING: " & _
                FormatDuration(remaining)


            document.getElementById("selectedPlan").innerHTML = _
                "CURRENT PLAN: " & subscriptionPlan

        End If


    Else

        document.getElementById("trialNotice").innerHTML = _
            "TRIAL VERSION - SUBSCRIBE TO CONTINUE"


        document.getElementById("selectedPlan").innerHTML = _
            "SELECT A PLAN BELOW"

    End If

End Sub


'========================================================
' SUBSCRIPTION TIMER
'========================================================

Sub UpdateSubscriptionTimer

    CheckSubscription


    If subscriptionActive = True Then

        UpdateSubscriptionDisplay


        If document.getElementById("subscriptionOverlay").style.display = "block" Then

            UpdateSubscriptionWindow

        End If

    End If


    window.setTimeout "UpdateSubscriptionTimer", 1000

End Sub


'========================================================
' UNIX TIME
'========================================================

Function UnixTime

    UnixTime = DateDiff( _
        "s", _
        "01/01/1970 00:00:00", _
        Now())

End Function


'========================================================
' FORMAT TIME
'========================================================

Function FormatDuration(totalSeconds)

    Dim days
    Dim hours
    Dim minutes
    Dim seconds
    Dim result


    totalSeconds = Int(totalSeconds)


    If totalSeconds < 0 Then

        totalSeconds = 0

    End If


    days = Int(totalSeconds / 86400)

    totalSeconds = totalSeconds Mod 86400


    hours = Int(totalSeconds / 3600)

    totalSeconds = totalSeconds Mod 3600


    minutes = Int(totalSeconds / 60)

    seconds = totalSeconds Mod 60


    result = ""


    If days > 0 Then

        result = result & days & "D "

    End If


    result = result & _
        Right("0" & hours, 2) & ":" & _
        Right("0" & minutes, 2) & ":" & _
        Right("0" & seconds, 2)


    FormatDuration = result

End Function


'========================================================
' EXPIRED SCREEN
'========================================================

Sub ShowExpiredScreen

    document.getElementById("expiredOverlay").style.display = "block"

    document.getElementById("expiredPlan").innerHTML = _
        subscriptionPlan

End Sub


Sub ExpiredSubscribe

    document.getElementById("expiredOverlay").style.display = "none"

    OpenSubscription

End Sub


'========================================================
' ABOUT
'========================================================

Sub AboutLauncher

    MsgBox _
        "JAIDEN GAMING DASHBOARD" & vbCrLf & vbCrLf & _
        "Version " & launcherVersion & vbCrLf & _
        "GTA V + SJ Gaming Launcher" & vbCrLf & vbCrLf & _
        "Developed By SJ Gaming" & vbCrLf & _
        "Designed & Created By SJ Gaming" & vbCrLf & _
        "Ideas & Concept By SJ Gaming", _
        vbInformation, _
        "About JAIDEN GAMING"

End Sub


'========================================================
' EXIT
'========================================================

Sub ExitGame

    window.close

End Sub


'========================================================
' VERSION DISPLAY
'========================================================

Sub SetVersionDisplay

    document.getElementById("footerVersion").innerHTML = _
        launcherVersion

    document.getElementById("settingsVersion").innerHTML = _
        launcherVersion

    UpdateSubscriptionDisplay

End Sub

</script>

</head>


<body>


<!-- TOP BAR -->

<div class="topbar">

    <div class="brand">
        JAIDEN
        <span class="brandSub">GAMING</span>
    </div>

    <div class="userArea">

        <div class="userName">
            JAIDEN
        </div>

        <div class="online">
            ONLINE
        </div>

    </div>

</div>


<!-- SIDEBAR -->

<div class="sidebar">

    <div class="menuHeader">
        NAVIGATION
    </div>


    <button class="menuButton menuActive">
        DASHBOARD
    </button>


    <button class="menuButton"
            onclick="OpenGameFolder">

        GAME FOLDER

    </button>


    <button class="menuButton"
            onclick="CheckForUpdates">

        UPDATES

    </button>


    <div class="menuLine"></div>


    <div class="menuHeader">
        SYSTEM
    </div>


    <button class="menuButton"
            onclick="OpenSettings">

        SETTINGS

    </button>


    <button class="menuButton"
            onclick="AboutLauncher">

        ABOUT

    </button>


    <button class="exitButton"
            onclick="ExitGame">

        EXIT LAUNCHER

    </button>

</div>


<!-- MAIN CONTENT -->

<div class="content">

    <div class="smallTitle">
        JAIDEN GAMING / DASHBOARD
    </div>


    <div class="mainTitle">
        GAMING <span>CENTER</span>
    </div>


    <div class="gameCard">

        <div class="gameLabel">
            AVAILABLE GAME
        </div>


        <div class="gameName">
            GRAND THEFT AUTO V
        </div>


        <div class="gameDescription">
            Roleplay launcher with SJ Gaming
        </div>


        <button class="subscriptionButton"
                onclick="OpenSubscription">

            SUBSCRIPTION

        </button>


        <button id="playButton"
                class="playButton"
                onclick="PlayGame">

            PLAY GAME

        </button>

    </div>


    <!-- STATUS -->

    <div class="statusPanel">

        <div class="statusHeader">
            SYSTEM STATUS
        </div>


        <div class="statusRow">

            <span class="statusName">
                GRAND THEFT AUTO V
            </span>


            <span id="gtaStatus">
                CHECKING...
            </span>

        </div>


        <div class="statusRow">

            <span class="statusName">
                SJ GAMING
            </span>


            <span id="sjStatus">
                CHECKING...
            </span>

        </div>


        <div class="statusRow">

            <span class="statusName">
                SUBSCRIPTION
            </span>


            <span id="subscriptionStatus">
                CHECKING...
            </span>

        </div>

    </div>


    <!-- INFO -->

    <div class="infoContainer">

        <div class="infoCard">

            <div class="infoTitle">
                PLAN
            </div>


            <div id="subscriptionPlanDisplay"
                 class="infoValue">

                TRIAL VERSION

            </div>

        </div>


        <div class="infoCard">

            <div class="infoTitle">
                REMAINING TIME
            </div>


            <div id="subscriptionTimeDisplay"
                 class="infoValue">

                SUBSCRIBE TO CONTINUE

            </div>

        </div>


        <div class="infoCard">

            <div class="infoTitle">
                DEVELOPED BY
            </div>


            <div class="infoValue">
                SJ GAMING
            </div>

        </div>

    </div>


    <div class="footer">

        JAIDEN GAMING DASHBOARD -
        DEVELOPED BY SJ GAMING -
        VERSION <span id="footerVersion">6.0</span>

    </div>

</div>


<!-- GAME LOADING -->

<div id="loadingScreen"
     class="overlay">

    <div class="updateBox">

        <div class="updateBrand">
            JAIDEN GAMING
        </div>


        <div class="updateTitle">
            Enjoy The Game Jaiden!
        </div>


        <div class="updateText">
            Please wait, the game is loading...
        </div>


        <div class="updateAnimation">

            <span></span>
            <span></span>
            <span></span>
            <span></span>

        </div>


        <div id="loadingStatus"
             style="color:#00ff88;font-size:11px;margin-top:10px;">

            PREPARING GAME...

        </div>

    </div>

</div>


<!-- UPDATE CENTER -->

<div id="updateOverlay"
     class="overlay">

    <div class="updateBox">

        <div class="updateBrand">
            JAIDEN GAMING
        </div>


        <div class="updateTitle">
            UPDATE CENTER
        </div>


        <div id="updateText"
             class="updateText">

            Checking GitHub for updates...

        </div>


        <div id="updateChecking"
             class="updateAnimation">

            <span></span>
            <span></span>
            <span></span>
            <span></span>

        </div>


        <div id="updateAvailable"
             style="display:none;">

            <div style="
                color:#00ff88;
                font-size:18px;
                font-weight:bold;
                margin-bottom:5px;">

                NEW VERSION AVAILABLE

            </div>


            <div class="whatsNewBox">

                <div class="whatsNewHeader">
                    WHAT'S NEW
                </div>


                <div id="whatsNewContent"
                     class="whatsNewContent">

                    <div>
                        <span class="whatsNewBullet">+</span>
                        Loading changes from GitHub...
                    </div>

                </div>

            </div>


            <button class="updateButton updateNow"
                    onclick="UpdateNow">

                UPDATE NOW

            </button>


            <button class="updateButton updateLater"
                    onclick="UpdateLater">

                UPDATE LATER

            </button>

        </div>


        <div id="updateInstalling"
             style="display:none;">

            <div class="updateAnimation">

                <span></span>
                <span></span>
                <span></span>
                <span></span>

            </div>


            <div style="
                color:#00ff88;
                font-size:18px;
                font-weight:bold;">

                INSTALLING UPDATE...

            </div>


            <div style="
                color:#777777;
                font-size:11px;
                margin-top:12px;">

                Downloading from SJ Server...

            </div>

        </div>


        <div id="updateCompleted"
             style="display:none;">

            <div style="
                color:#00ff88;
                font-size:20px;
                font-weight:bold;
                letter-spacing:2px;">

                UPDATE COMPLETED

            </div>


            <div style="
                color:#777777;
                font-size:11px;
                margin-top:12px;">

                Restarting JAIDEN GAMING...

            </div>

        </div>

    </div>

</div>


<!-- LOGIN -->

<div id="loginOverlay"
     class="overlay">

    <div class="loginBox">

        <div class="loginBrand">
            JAIDEN GAMING SECURITY
        </div>


        <div class="loginTitle">
            ADMIN ACCESS
        </div>


        <div class="loginDescription">
            Administrator authentication is required
            to access Settings.
        </div>


        <label class="inputLabel">
            LOGIN ID
        </label>


        <input
            id="loginID"
            class="loginInput"
            type="text"
            autocomplete="off"
            spellcheck="false"
            maxlength="50"
            value="1111111111111111111111"
            onkeyup="ProtectLoginID"
            onkeydown="ProtectLoginID">


        <label class="inputLabel">
            PASSWORD
        </label>


        <input
            id="loginPassword"
            class="loginInput"
            type="password"
            autocomplete="off"
            maxlength="50"
            value="11111111111111111111"
            onkeyup="ProtectPassword"
            onkeydown="ProtectPassword">


        <button class="loginButton"
                onclick="AdminLogin">

            LOGIN

        </button>


        <button class="cancelButton"
                onclick="CancelLogin">

            CANCEL

        </button>


        <div id="loginError"
             class="loginError">

            ACCESS DENIED

        </div>

    </div>

</div>


<!-- SECURITY LOCK -->

<div id="lockOverlay"
     class="overlay">

    <div class="lockBox">

        <div class="lockBrand">
            JAIDEN GAMING SECURITY
        </div>


        <div class="lockTitle">
            ADMIN ACCESS LOCKED
        </div>


        <div class="lockMessage">

            End to End Encryption Data Protection Activated

            <br><br>

            Contact Admin for unlock

        </div>


        <div class="lockSub">
            Maximum login attempts exceeded.
        </div>


        <button class="closeSettings"
                onclick="CloseLockScreen">

            CLOSE

        </button>

    </div>

</div>


<!-- SETTINGS -->

<div id="settingsOverlay"
     class="overlay">

    <div class="settingsBox">

        <div class="settingsTitle">
            JAIDEN GAMING SETTINGS
        </div>


        <div class="settingRow">

            <span class="settingName">
                GAME
            </span>


            <span class="settingValue">
                GRAND THEFT AUTO V
            </span>

        </div>


        <div class="settingRow">

            <span class="settingName">
                SJ GAMING
            </span>


            <span class="settingValue">
                ENABLED
            </span>

        </div>


        <div class="settingRow">

            <span class="settingName">
