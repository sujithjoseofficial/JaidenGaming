<html>
<head>

<title>JAIDEN GAMING</title>

<HTA:APPLICATION
    ID="JaidenGaming"
    APPLICATIONNAME="Jaiden Gaming"
    BORDER="thin"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    SCROLL="yes"
    WINDOWSTATE="normal"
    MINIMIZEBUTTON="yes"
    MAXIMIZEBUTTON="yes"
>

<style type="text/css">

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: #070a09;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
    overflow: hidden;
}

* {
    box-sizing: border-box;
}

.topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 70px;
    background: #0c110f;
    border-bottom: 1px solid #203128;
}

.brand {
    position: absolute;
    left: 25px;
    top: 12px;
    color: #00ff88;
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 3px;
}

.brandSub {
    color: white;
    font-size: 16px;
    letter-spacing: 2px;
    margin-left: 8px;
    vertical-align: middle;
}

.userArea {
    position: absolute;
    right: 25px;
    top: 15px;
    text-align: right;
}

.userName {
    color: white;
    font-size: 14px;
    font-weight: bold;
}

.online {
    color: #00ff88;
    font-size: 10px;
    margin-top: 5px;
    letter-spacing: 1px;
}

.sidebar {
    position: absolute;
    left: 0;
    top: 70px;
    bottom: 0;
    width: 205px;
    background: #0a0e0c;
    border-right: 1px solid #1b2b23;
    padding-top: 20px;
}

.menuHeader {
    color: #555555;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    height: 16px;
    line-height: 16px;
    margin-left: 20px;
    margin-bottom: 10px;
}

.menuButton {
