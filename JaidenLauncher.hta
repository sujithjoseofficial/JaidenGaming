            </div>


            <div id="codeError"
                 class="codeError">

                INVALID ACTIVATION CODE

            </div>


            <button class="activateButton"
                    onclick="ActivateSubscription">

                ACTIVATE SUBSCRIPTION

            </button>

        </div>


        <button class="subscriptionClose"
                onclick="CloseSubscription">

            CLOSE

        </button>

    </div>

</div>


<!-- EXPIRED -->

<div id="expiredOverlay"
     class="overlay">

    <div class="expiredBox">

        <div class="updateBrand">
            JAIDEN GAMING
        </div>


        <div class="expiredTitle">
            SUBSCRIPTION EXPIRED
        </div>


        <div class="expiredText">

            Your subscription has expired.

            <br>

            Plan:
            <span id="expiredPlan">
                SUBSCRIPTION
            </span>

            <br><br>

            Subscribe to continue using JAIDEN GAMING.

        </div>


        <button class="expiredButton"
                onclick="ExpiredSubscribe">

            SUBSCRIBE TO CONTINUE

        </button>

    </div>

</div>


<script language="VBScript">

window.setTimeout "UpdateSubscriptionTimer", 1000

</script>


</body>
</html>
