</div>


<!-- SUBSCRIPTION -->

<div id="subscriptionOverlay"
     class="overlay">

    <div class="subscriptionBox">

        <div class="subscriptionBrand">
            JAIDEN GAMING
        </div>


        <div class="subscriptionTitle">
            SUBSCRIPTION CENTER
        </div>


        <div id="trialNotice"
             class="trialNotice">

            TRIAL VERSION - SUBSCRIBE TO CONTINUE

        </div>


        <button class="plan"
                onclick="SelectOneMinute">

            <span class="planName">
                1 MINUTE
            </span>

            <span class="planPrice">
                AED 1
            </span>

        </button>


        <button class="plan"
                onclick="SelectOneDay">

            <span class="planName">
                1 HOUR
            </span>

            <span class="planPrice">
                AED 30
            </span>

        </button>


        <button class="plan"
                onclick="SelectThreeDays">

            <span class="planName">
                3 HOURS
            </span>

            <span class="planPrice">
                AED 50
            </span>

        </button>


        <button class="plan"
                onclick="SelectSevenDays">

            <span class="planName">
                7 DAYS
            </span>

            <span class="planPrice">
                AED 70
            </span>

        </button>


        <button class="plan"
                onclick="SelectOneMonth">

